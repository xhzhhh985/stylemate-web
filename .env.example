# Application
APP_ENV=development

# Database: without DATABASE_URL, the backend uses backend/stylemate.db (SQLite).
# For a local SQLite override, uncomment and run commands from backend/:
# DATABASE_URL=sqlite:///./stylemate.db
# For cloud PostgreSQL, install psycopg and use the provider's connection details:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/stylemate

# AI provider
AI_ENABLED=false
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=glm-4.6v-flash
